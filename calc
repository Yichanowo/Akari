<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>AkariBot 计算器</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            background: #faf5f7;
            padding: 20px 16px 40px;
            color: #3d2c3a;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            margin-bottom: 28px;
        }
        .header h1 {
            font-size: 1.8rem;
            font-weight: 600;
            background: linear-gradient(135deg, #884499, #DDAACC);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 8px;
        }
        .header p {
            color: #8a6b7e;
            font-size: 0.9rem;
        }
        .section {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 4px 12px rgba(136, 68, 153, 0.08);
            margin-bottom: 28px;
            overflow: hidden;
            border: 1px solid #f0e4ea;
        }
        .section-title {
            background: #fdf8fb;
            padding: 16px 20px;
            border-bottom: 1px solid #f0e4ea;
            font-size: 1.3rem;
            font-weight: 600;
            color: #884499;
        }
        .cmd-list {
            padding: 8px 0;
        }
        .cmd-card {
            padding: 14px 20px;
            border-bottom: 1px solid #f5eaf0;
        }
        .cmd-card:last-child {
            border-bottom: none;
        }
        .cmd-name {
            font-family: monospace;
            font-weight: 600;
            font-size: 1rem;
            color: #BB6688;
            margin-bottom: 12px;
        }
        .param-group {
            margin: 12px 0;
        }
        .param-group label {
            display: block;
            font-size: 0.85rem;
            margin-bottom: 4px;
            color: #5a4b55;
        }
        .param-group input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #f0e4ea;
            border-radius: 16px;
            font-size: 0.9rem;
            background: #fff;
            transition: 0.2s;
        }
        .param-group input:focus {
            outline: none;
            border-color: #DDAACC;
            box-shadow: 0 0 0 2px rgba(187, 102, 136, 0.1);
        }
        button {
            background: #DDAACC;
            color: white;
            border: none;
            border-radius: 40px;
            padding: 10px 20px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 8px;
            width: auto;
            min-width: 120px;
        }
        button:hover {
            background: #ad789c;
        }
        .result {
            background: #fdf4f9;
            border-left: 3px solid #DDAACC;
            padding: 12px 16px;
            border-radius: 16px;
            font-size: 0.9rem;
            color: #884499;
            margin-top: 16px;
            white-space: pre-wrap;
        }
        .result span.highlight {
            color: #BB6688;
            font-weight: bold;
        }
        .note {
            font-size: 0.75rem;
            color: #b39fb0;
            margin-top: 12px;
            text-align: center;
        }
        footer {
            text-align: center;
            margin-top: 30px;
            font-size: 0.75rem;
            color: #b39fb0;
            border-top: 1px solid #f0e4ea;
            padding-top: 1rem;
        }
        hr {
            margin: 8px 0;
            border: none;
            border-top: 1px solid #f0e4ea;
        }
        @media (max-width: 600px) {
            body {
                padding: 12px;
            }
            .cmd-card {
                padding: 12px 16px;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>AkariBot网页计算器</h1>
        <p>QQ计算器网页版</p>
    </div>

    <!-- ================= 原等级表（/leader & /exp） ================= -->
    <div class="section">
        <div class="section-title">队长任务</div>
        <div class="cmd-list">
            <div class="cmd-card">
                <div class="cmd-name">计算升到目标等级所需天数</div>
                <div class="param-group"><label>当前队长次数</label><input type="number" id="leader_start" placeholder="例：4000"></div>
                <div class="param-group"><label>每日获得的队长次数</label><input type="number" id="leader_daily" placeholder="例：500"></div>
                <div class="param-group"><label>要获得的角色章数</label><input type="number" id="leader_badge" placeholder="例：2"></div>
                <button id="leader_btn">计算所需天数</button>
                <div id="leader_result" class="result"> </div>
            </div>
            <hr>
            <div class="cmd-card">
                <div class="cmd-name">计算游玩指定天数后能达到的等级</div>
                <div class="param-group"><label>当前队长次数</label><input type="number" id="exp_start" placeholder="例：4000"></div>
                <div class="param-group"><label>每日获得的队长次数</label><input type="number" id="exp_daily" placeholder="例：500"></div>
                <div class="param-group"><label>游玩天数</label><input type="number" id="exp_days" placeholder="例：5"></div>
                <button id="exp_btn">计算最终等级</button>
                <div id="exp_result" class="result"> </div>
            </div>
        </div>
    </div>

    <!-- ================= EX等级表（/exleader & /exexp） ================= -->
    <div class="section">
        <div class="section-title">EX队长任务</div>
        <div class="cmd-list">
            <div class="cmd-card">
                <div class="cmd-name">计算升到目标EX等级所需天数</div>
                <div class="param-group"><label>当前EX队长次数</label><input type="number" id="exleader_start" placeholder="例：4000"></div>
                <div class="param-group"><label>每日获得的队长次数</label><input type="number" id="exleader_daily" placeholder="例：500"></div>
                <div class="param-group"><label>要获得的角色章数</label><input type="number" id="exleader_badge" placeholder="例：2"></div>
                <button id="exleader_btn">计算所需天数</button>
                <div id="exleader_result" class="result"> </div>
            </div>
            <hr>
            <div class="cmd-card">
                <div class="cmd-name">/exexp &nbsp; 计算游玩指定天数后能达到的EX等级</div>
                <div class="param-group"><label>当前EX队长次数</label><input type="number" id="exexp_start" placeholder="例：4000"></div>
                <div class="param-group"><label>每日获得的EX队长次数</label><input type="number" id="exexp_daily" placeholder="例：500"></div>
                <div class="param-group"><label>游玩天数</label><input type="number" id="exexp_days" placeholder="例：5"></div>
                <button id="exexp_btn">计算最终等级</button>
                <div id="exexp_result" class="result"> </div>
            </div>
        </div>
    </div>

    <!-- ================= 羁绊计算（/kizuna & /kizunadays） ================= -->
    <div class="section">
        <div class="section-title">羁绊等级</div>
        <div class="cmd-list">
            <div class="cmd-card">
                <div class="cmd-name">计算羁绊升到目标等级所需天数</div>
                <div class="param-group"><label>当前羁绊等级</label><input type="number" id="kizuna_level" placeholder="例：1"></div>
                <div class="param-group"><label>距离下一级所需经验</label><input type="number" id="kizuna_need" placeholder="例：7224"></div>
                <div class="param-group"><label>一天总把数</label><input type="number" id="kizuna_total_plays" placeholder="例：50"></div>
                <div class="param-group"><label>目标等级</label><input type="number" id="kizuna_target" placeholder="例：2"></div>
                <div class="param-group"><label>火数量（可选，0~10，不填默认0火）</label><input type="number" id="kizuna_fire_count" placeholder="默认0"></div>
                <div class="param-group"><label>用火把数（可选，不填则全部用火）</label><input type="number" id="kizuna_fire_plays" placeholder="默认全部用火"></div>
                <button id="kizuna_btn">计算所需天数</button>
                <div id="kizuna_result" class="result"> </div>
            </div>
            <hr>
            <div class="cmd-card">
                <div class="cmd-name">/kizunadays &nbsp; 计算游玩指定天数后能达到的羁绊等级</div>
                <div class="param-group"><label>当前羁绊等级</label><input type="number" id="kizdays_level" placeholder="例：1"></div>
                <div class="param-group"><label>距离下一级所需经验</label><input type="number" id="kizdays_need" placeholder="例：7224"></div>
                <div class="param-group"><label>一天总把数</label><input type="number" id="kizdays_total_plays" placeholder="例：50"></div>
                <div class="param-group"><label>游玩天数</label><input type="number" id="kizdays_days" placeholder="例：5"></div>
                <div class="param-group"><label>火数量（可选，0~10，不填默认0火）</label><input type="number" id="kizdays_fire_count" placeholder="默认0"></div>
                <div class="param-group"><label>用火把数（可选，不填则全部用火）</label><input type="number" id="kizdays_fire_plays" placeholder="默认全部用火"></div>
                <button id="kizdays_btn">计算最终等级</button>
                <div id="kizdays_result" class="result"> </div>
            </div>
        </div>
    </div>

    <footer>数据来源bilibili@xfl03 | 制作 伊ちゃん</footer>
</div>

<script>
    // ---------- 1. 原等级表数据 ----------
    const baseLevels = [
        [1,10],[2,20],[3,40],[4,60],[5,90],[6,120],[7,160],[8,200],[9,250],[10,300],
        [11,360],[12,420],[13,490],[14,560],[15,640],[16,720],[17,810],[18,900],[19,1000],[20,1100],
        [21,1210],[22,1320],[23,1440],[24,1560],[25,1690],[26,1820],[27,1960],[28,2100],[29,2250],[30,2400],
        [31,2560],[32,2720],[33,2890],[34,3060],[35,3240],[36,3420],[37,3610],[38,3800],[39,4000],[40,4200],
        [41,4410],[42,4620],[43,4840],[44,5060],[45,5290],[46,5520],[47,5760],[48,6000],[49,6250],[50,6500],
        [51,6750],[52,7000],[53,7300],[54,7600],[55,7950],[56,8300],[57,8700],[58,9100],[59,9550],[60,10000]
    ];
    const levelMap = Object.fromEntries(baseLevels);
    const MAX_TOTAL = 50000;
    const MAX_LEVEL = 60 + Math.floor((MAX_TOTAL - 10000) / 500); // 140

    function getTotalByLevel(level) {
        if (level <= 60) return levelMap[level];
        if (level > MAX_LEVEL) level = MAX_LEVEL;
        return 10000 + (level - 60) * 500;
    }
    function getLevelByTotal(total) {
        if (total >= MAX_TOTAL) return MAX_LEVEL;
        if (total <= 10000) {
            for (let i = baseLevels.length - 1; i >= 0; i--) if (baseLevels[i][1] <= total) return baseLevels[i][0];
            return 0;
        }
        return 60 + Math.floor((total - 10000) / 500);
    }
    function calcDaysForBadge(startTotal, daily, targetBadge) {
        if (daily <= 0) return Infinity;
        if (targetBadge <= 0) return 0;
        const startLevel = getLevelByTotal(startTotal);
        const targetLevel = startLevel + targetBadge;
        if (targetLevel > MAX_LEVEL) return -1;
        const targetTotal = getTotalByLevel(targetLevel);
        const need = targetTotal - startTotal;
        if (need <= 0) return 0;
        return Math.ceil(need / daily);
    }
    function calcExpResult(startTotal, daily, days) {
        const newTotal = startTotal + daily * days;
        if (newTotal > MAX_TOTAL) {
            const needToMax = MAX_TOTAL - startTotal;
            const actualDays = Math.ceil(needToMax / daily);
            return { full: true, actualDays, startLevel: getLevelByTotal(startTotal) };
        } else {
            const newLevel = getLevelByTotal(newTotal);
            return { full: false, newLevel, startLevel: getLevelByTotal(startTotal) };
        }
    }

    // ---------- 2. EX等级表数据 ----------
    const exLevels = [
        [1,500],[2,1000],[3,1500],[4,2100],[5,2700],[6,3300],[7,4000],[8,4700],[9,5400],[10,6200],
        [11,7000],[12,7800],[13,8700],[14,9600],[15,10500],[16,11500],[17,12500],[18,13500],[19,14600],[20,15700],
        [21,16800],[22,18000],[23,19200],[24,20400],[25,21700],[26,23000],[27,24300],[28,25700],[29,27100],[30,28500]
    ];
    const exLevelMap = Object.fromEntries(exLevels);
    const EX_MAX_TOTAL = 28500;
    const EX_MAX_LEVEL = 30;

    function getExTotalByLevel(level) {
        if (level <= EX_MAX_LEVEL) return exLevelMap[level];
        return EX_MAX_TOTAL;
    }
    function getExLevelByTotal(total) {
        if (total >= EX_MAX_TOTAL) return EX_MAX_LEVEL;
        for (let i = exLevels.length - 1; i >= 0; i--) if (exLevels[i][1] <= total) return exLevels[i][0];
        return 0;
    }
    function calcDaysForBadgeEx(startTotal, daily, targetBadge) {
        if (daily <= 0) return Infinity;
        if (targetBadge <= 0) return 0;
        const startLevel = getExLevelByTotal(startTotal);
        const targetLevel = startLevel + targetBadge;
        if (targetLevel > EX_MAX_LEVEL) return -1;
        const targetTotal = getExTotalByLevel(targetLevel);
        const need = targetTotal - startTotal;
        if (need <= 0) return 0;
        return Math.ceil(need / daily);
    }
    function calcExpResultEx(startTotal, daily, days) {
        const newTotal = startTotal + daily * days;
        if (newTotal > EX_MAX_TOTAL) {
            const needToMax = EX_MAX_TOTAL - startTotal;
            const actualDays = Math.ceil(needToMax / daily);
            return { full: true, actualDays, startLevel: getExLevelByTotal(startTotal) };
        } else {
            const newLevel = getExLevelByTotal(newTotal);
            return { full: false, newLevel, startLevel: getExLevelByTotal(startTotal) };
        }
    }

    // ---------- 3. 羁绊数据 ----------
    const kizunaExpFixed = [
        0,7224,7224,7224,7224,7224,28094,28094,28092,60200,60200,60200,70234,70234,70232,
        100334,100334,100332,130434,130434,130432,160534,160534,160532,210700,210700,210700,
        250834,250834,250832,280934,280934,280932,301000,301000,301000,301000,301000,301000,
        301000,301000,301000,301000,301000,301000,301000,301000,301000,301000,301000,301000
    ];
    const KIZUNA_MAX_LEVEL = 125;
    const kizunaExp = [...kizunaExpFixed];
    for (let i = 51; i < KIZUNA_MAX_LEVEL; i++) kizunaExp[i] = 301000;

    function calcKizunaTotalNeed(currentLevel, needToNext, targetLevel) {
        let total = needToNext;
        for (let lvl = currentLevel; lvl < targetLevel; lvl++) total += kizunaExp[lvl];
        return total;
    }
    function calcKizunaDailyGain(totalPlays, fireCount, firePlays) {
        const base = 150;
        let multiplier = (fireCount === 0) ? 1 : (fireCount <= 5) ? fireCount * 5 : fireCount + 20;
        if (firePlays === undefined || firePlays === null || firePlays === '') return totalPlays * base * multiplier;
        const zeroPlays = totalPlays - firePlays;
        return zeroPlays * base + firePlays * base * multiplier;
    }
    function calcKizunaLevelByDays(currentLevel, needToNext, totalPlays, days, fireCount, firePlays) {
        const dailyGain = calcKizunaDailyGain(totalPlays, fireCount, firePlays);
        let remainingExp = dailyGain * days;
        let level = currentLevel;
        let need = needToNext;
        if (remainingExp >= need) {
            remainingExp -= need;
            level++;
            while (level < KIZUNA_MAX_LEVEL && remainingExp >= kizunaExp[level]) {
                remainingExp -= kizunaExp[level];
                level++;
            }
        }
        if (level === KIZUNA_MAX_LEVEL) {
            let totalNeed = needToNext;
            for (let lvl = currentLevel; lvl < KIZUNA_MAX_LEVEL; lvl++) totalNeed += kizunaExp[lvl];
            const actualDays = Math.ceil(totalNeed / dailyGain);
            return { full: true, actualDays, level: KIZUNA_MAX_LEVEL, gained: KIZUNA_MAX_LEVEL - currentLevel };
        } else {
            const gained = level - currentLevel;
            return { full: false, level, gained, remainingExp, needNext: kizunaExp[level] - remainingExp };
        }
    }

    // 辅助函数：高亮结果中的天数/等级数字（只高亮最终数值）
    function highlightNumbers(text) {
        // 高亮 “需要 X 天” 中的 X
        let t = text.replace(/需要 (\d+) 天/g, (_, num) => `需要<span class="highlight">${num}</span>天`);
        // 高亮 “实际用时 X 天”
        t = t.replace(/实际用时 (\d+) 天/g, (_, num) => `实际用时<span class="highlight">${num}</span>天`);
        // 高亮 “升至 X” 中的 X（等级）
        t = t.replace(/升至 (\d+)([级])/g, (_, num, suffix) => `升至<span class="highlight">${num}</span>${suffix}`);
        // 高亮 “共提升 X 级”
        t = t.replace(/共提升 (\d+) 级/g, (_, num) => `共提升<span class="highlight">${num}</span>级`);
        // 高亮 “达到等级 X” 中的 X
        t = t.replace(/达到等级 (\d+)/g, (_, num) => `达到等级<span class="highlight">${num}</span>`);
        // 高亮 “需要 X 天” 的另一种形式（超限提示中的）
        t = t.replace(/需要 (\d+) 天。/g, (_, num) => `需要<span class="highlight">${num}</span>天。`);
        return t;
    }

    // ---------- 绑定事件 ----------
    // /leader
    document.getElementById('leader_btn').addEventListener('click', () => {
        const startTotal = parseInt(document.getElementById('leader_start').value);
        const daily = parseInt(document.getElementById('leader_daily').value);
        const targetBadge = parseInt(document.getElementById('leader_badge').value);
        let res = '';
        if (isNaN(startTotal) || isNaN(daily) || isNaN(targetBadge)) res = '请填写完整的数字参数';
        else if (daily <= 0) res = '每日次数必须大于0';
        else if (targetBadge < 0) res = '目标章数不能为负数';
        else if (startTotal > MAX_TOTAL) res = `当前队长次数已超出上限${MAX_TOTAL}`;
        else {
            const startLevel = getLevelByTotal(startTotal);
            const days = calcDaysForBadge(startTotal, daily, targetBadge);
            if (days === -1) {
                const maxPossible = MAX_LEVEL - startLevel;
                const needToMax = MAX_TOTAL - startTotal;
                const daysToMax = Math.ceil(needToMax / daily);
                res = `无法获得${targetBadge}个角色章，已超过上限${MAX_TOTAL}次。到上限前仅能获得${maxPossible}个角色章，需要${daysToMax}天。`;
            } else {
                const endLevel = startLevel + targetBadge;
                res = `当前队长次数${startTotal}（等级 ${startLevel}），每天打${daily}次，要获得${targetBadge}个角色章（达到等级${endLevel}）需要${days}天。`;
            }
        }
        document.getElementById('leader_result').innerHTML = highlightNumbers(res);
    });
    // /exp
    document.getElementById('exp_btn').addEventListener('click', () => {
        const startTotal = parseInt(document.getElementById('exp_start').value);
        const daily = parseInt(document.getElementById('exp_daily').value);
        const days = parseInt(document.getElementById('exp_days').value);
        let res = '';
        if (isNaN(startTotal) || isNaN(daily) || isNaN(days)) res = '请填写完整的数字参数';
        else if (daily <= 0) res = '每日次数必须大于0';
        else if (days < 0) res = '游玩天数不能为负数';
        else if (startTotal > MAX_TOTAL) res = `当前队长次数已超出上限${MAX_TOTAL}`;
        else {
            const r = calcExpResult(startTotal, daily, days);
            if (r.full) res = `在游玩${days}天期间已经达到满级${MAX_LEVEL}级，实际用时${r.actualDays}天。`;
            else res = `游玩${days}天后，等级从${r.startLevel}升至 ${r.newLevel}，共提升${r.newLevel - r.startLevel}级。`;
        }
        document.getElementById('exp_result').innerHTML = highlightNumbers(res);
    });
    // /exleader
    document.getElementById('exleader_btn').addEventListener('click', () => {
        const startTotal = parseInt(document.getElementById('exleader_start').value);
        const daily = parseInt(document.getElementById('exleader_daily').value);
        const targetBadge = parseInt(document.getElementById('exleader_badge').value);
        let res = '';
        if (isNaN(startTotal) || isNaN(daily) || isNaN(targetBadge)) res = '请填写完整的数字参数';
        else if (daily <= 0) res = '每日次数必须大于0';
        else if (targetBadge < 0) res = '目标章数不能为负数';
        else if (startTotal > EX_MAX_TOTAL) res = `当前队长次数已超出EX上限${EX_MAX_TOTAL}`;
        else {
            const startLevel = getExLevelByTotal(startTotal);
            const days = calcDaysForBadgeEx(startTotal, daily, targetBadge);
            if (days === -1) {
                const maxPossible = EX_MAX_LEVEL - startLevel;
                const needToMax = EX_MAX_TOTAL - startTotal;
                const daysToMax = Math.ceil(needToMax / daily);
                res = `无法获得${targetBadge}个角色章，已超过上限${EX_MAX_TOTAL}次。到上限前仅能获得${maxPossible}个角色章，需要${daysToMax}天。`;
            } else {
                const endLevel = startLevel + targetBadge;
                res = `当前EX队长次数${startTotal}（EX等级 ${startLevel}），每天打${daily} 次，要获得${targetBadge}个角色章（达到 EX等级${endLevel}）需要${days}天。`;
            }
        }
        document.getElementById('exleader_result').innerHTML = highlightNumbers(res);
    });
    // /exexp
    document.getElementById('exexp_btn').addEventListener('click', () => {
        const startTotal = parseInt(document.getElementById('exexp_start').value);
        const daily = parseInt(document.getElementById('exexp_daily').value);
        const days = parseInt(document.getElementById('exexp_days').value);
        let res = '';
        if (isNaN(startTotal) || isNaN(daily) || isNaN(days)) res = '请填写完整的数字参数';
        else if (daily <= 0) res = '每日次数必须大于0';
        else if (days < 0) res = '游玩天数不能为负数';
        else if (startTotal > EX_MAX_TOTAL) res = `当前队长次数已超出EX上限${EX_MAX_TOTAL}`;
        else {
            const r = calcExpResultEx(startTotal, daily, days);
            if (r.full) res = `在游玩${days}天期间已经达到满级${EX_MAX_LEVEL}级，实际用时${r.actualDays}天。`;
            else res = `游玩${days}天后，EX等级从${r.startLevel}升至${r.newLevel}，共提升${r.newLevel - r.startLevel}级。`;
        }
        document.getElementById('exexp_result').innerHTML = highlightNumbers(res);
    });
    // /kizuna
    document.getElementById('kizuna_btn').addEventListener('click', () => {
        const currentLevel = parseInt(document.getElementById('kizuna_level').value);
        const needToNext = parseInt(document.getElementById('kizuna_need').value);
        const totalPlays = parseInt(document.getElementById('kizuna_total_plays').value);
        const targetLevel = parseInt(document.getElementById('kizuna_target').value);
        let fireCount = 0, firePlays;
        const fc = document.getElementById('kizuna_fire_count').value;
        const fp = document.getElementById('kizuna_fire_plays').value;
        if (fc !== '') fireCount = parseInt(fc);
        if (fp !== '') firePlays = parseInt(fp);
        let res = '';
        if (isNaN(currentLevel) || isNaN(needToNext) || isNaN(totalPlays) || isNaN(targetLevel)) res = '请填写所有必填参数（等级、经验、把数、目标等级）';
        else if (currentLevel < 1 || currentLevel >= KIZUNA_MAX_LEVEL) res = `当前等级必须在1~${KIZUNA_MAX_LEVEL-1}之间`;
        else if (targetLevel <= currentLevel || targetLevel > KIZUNA_MAX_LEVEL) res = `目标等级必须大于当前等级且不超过 ${KIZUNA_MAX_LEVEL}`;
        else if (totalPlays <= 0) res = '一天总把数必须大于0';
        else if (fireCount < 0 || fireCount > 10) res = '火数量必须在0~10之间';
        else if (firePlays !== undefined && (firePlays < 0 || firePlays > totalPlays)) res = '用火把数不能小于0或超过总把数';
        else {
            const expForNext = kizunaExp[currentLevel];
            if (needToNext < 0 || needToNext >= expForNext) res = `距离下一级经验应在0~${expForNext-1}之间`;
            else {
                const totalNeed = calcKizunaTotalNeed(currentLevel, needToNext, targetLevel);
                const dailyGain = calcKizunaDailyGain(totalPlays, fireCount, firePlays);
                const days = Math.ceil(totalNeed / dailyGain);
                let fireDesc = (firePlays === undefined) ? `全部使用${fireCount}火` : `其中${firePlays}把使用${fireCount}火，其余无火`;
                res = `当前羁绊等级${currentLevel}，距离下一级还需${needToNext}经验，每天打${totalPlays}把${fireDesc}，要升到等级${targetLevel}需要 ${days} 天。`;
            }
        }
        document.getElementById('kizuna_result').innerHTML = highlightNumbers(res);
    });
    // /kizunadays
    document.getElementById('kizdays_btn').addEventListener('click', () => {
        const currentLevel = parseInt(document.getElementById('kizdays_level').value);
        const needToNext = parseInt(document.getElementById('kizdays_need').value);
        const totalPlays = parseInt(document.getElementById('kizdays_total_plays').value);
        const days = parseInt(document.getElementById('kizdays_days').value);
        let fireCount = 0, firePlays;
        const fc = document.getElementById('kizdays_fire_count').value;
        const fp = document.getElementById('kizdays_fire_plays').value;
        if (fc !== '') fireCount = parseInt(fc);
        if (fp !== '') firePlays = parseInt(fp);
        let res = '';
        if (isNaN(currentLevel) || isNaN(needToNext) || isNaN(totalPlays) || isNaN(days)) res = '请填写所有必填参数（等级、经验、把数、游玩天数）';
        else if (currentLevel < 1 || currentLevel >= KIZUNA_MAX_LEVEL) res = `当前等级必须在1~${KIZUNA_MAX_LEVEL-1}之间`;
        else if (days < 0) res = '游玩天数不能为负数';
        else if (totalPlays <= 0) res = '一天总把数必须大于0';
        else if (fireCount < 0 || fireCount > 10) res = '火数量必须在0~10之间';
        else if (firePlays !== undefined && (firePlays < 0 || firePlays > totalPlays)) res = '用火把数不能小于0或超过总把数';
        else {
            const expForNext = kizunaExp[currentLevel];
            if (needToNext < 0 || needToNext >= expForNext) res = `距离下一级经验应在0~${expForNext-1}之间`;
            else {
                const result = calcKizunaLevelByDays(currentLevel, needToNext, totalPlays, days, fireCount, firePlays);
                let fireDesc = (firePlays === undefined) ? `全部使用${fireCount}火` : `其中${firePlays}把使用${fireCount}火，其余无火`;
                if (result.full) res = `在游玩${days}天期间已经达到满级${KIZUNA_MAX_LEVEL}，实际用时${result.actualDays}天。共提升${result.gained}级。（每天打${totalPlays}把，${fireDesc}）`;
                else res = `游玩${days}天后，羁绊等级从${currentLevel}升至${result.level}，共提升${result.gained}级，距离下一级还需${result.needNext}经验（剩余经验 ${result.remainingExp}）。（每天打${totalPlays}把，${fireDesc}）`;
            }
        }
        document.getElementById('kizdays_result').innerHTML = highlightNumbers(res);
    });
</script>
